{
  "manifest_version": 3,
  "name": "VibeMeGood Sync",
  "version": "1.0.0",
  "description": "Auto-sync PrizePicks lines to your VibeMeGood Workstation",
  "permissions": ["alarms", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://*.prizepicks.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VibeMeGood Sync",
    "default_badge_text": ""
  }
}
